# quant-agent — 환경변수 템플릿
#
# 사용법:  cp .env.example .env  후 필요한 값만 채운다.
# 모든 값은 의도적으로 비워 두었다. 실제 키를 이 파일에 적어 커밋하지 말 것.
# (.env 는 .gitignore 로 차단되어 있다.)
#
# 이 저장소는 아카이브 상태이며 운영 중인 서비스가 없다.
# 아래 키는 운영 당시(2026-02-21 ~ 2026-06-13) 코드가 참조하던 항목이다.

# ── 거래소 / 브로커 ────────────────────────────────
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

KIWOOM_REST_API_KEY=
KIWOOM_REST_API_SECRET=
KIWOOM_ACCOUNT_NO=
KIWOOM_MOCK_REST_API_APP_KEY=
KIWOOM_MOCK_REST_API_SECRET_KEY=
KIWOOM_MOCK_ACCOUNT_NO=
KIWOOM_TEST_STOCK=

ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=

# ── 실행 모드 (안전 기본값: DRY_RUN 유지) ──────────
DRY_RUN=true
TRADING_ENV=
US_TRADING_ENV=

# ── 데이터 / 시황 API ──────────────────────────────
DART_API_KEY=
OPENDART_API_KEY=
POLYGON_API_KEY=
GLASSNODE_API_KEY=
CRYPTOPANIC_API_KEY=
BRAVE_API_KEY=

# ── LLM ────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── 저장소 (Supabase) ──────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SECRET_KEY=

# ── 알림 (Telegram) ────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Google Sheets 리포팅 ───────────────────────────
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=
GOOGLE_PORTFOLIO_SHEET_ID=
GOOGLE_PORTFOLIO_SHEET_URL=
GOOGLE_RISK_SHEET_ID=
GOOGLE_STATISTICS_SHEET_ID=
GOOGLE_SHEETS_CREDENTIALS_JSON=
GOG_ACCOUNT=
GOG_KEYRING_PASSWORD=
EXCEL_TRADE_LOG_PATH=

# ── 대시보드 ───────────────────────────────────────
DASHBOARD_USER=
DASHBOARD_PASSWORD=
DASHBOARD_PORT=
CORS_ORIGINS=
PUBLIC_API_KEYS=
PUBLIC_API_KEY_HASHES=

# ── 외부 연동 ──────────────────────────────────────
GITHUB_TOKEN=
NOTION_TOKEN=
NOTION_PAGE_ID=
JAY_AGENT_URL=
JAY_INTERNAL_TOKEN=
JAY_BRIDGE_TIMEOUT=
OPENCLAW_GATEWAY_TOKEN=

# ── 로깅 ───────────────────────────────────────────
LOG_LEVEL=
LOG_TO_FILE=
LOG_TO_CONSOLE=

# ── BTC 전략 파라미터 (미설정 시 코드 기본값 사용) ──
BTC_INVEST_RATIO=
BTC_MIN_CONFIDENCE=
BTC_BUY_COMPOSITE_MIN=
BTC_SELL_COMPOSITE_MAX=
BTC_STOP_LOSS=
BTC_TAKE_PROFIT=
BTC_TRAILING_STOP=
BTC_TRAILING_ACTIVATE=
BTC_TRAILING_ADAPTIVE=
BTC_PARTIAL_TP_PCT=
BTC_PARTIAL_TP_RATIO=
BTC_SPLIT_RATIOS=
BTC_SPLIT_RSI=
BTC_MAX_DAILY_LOSS=
BTC_MAX_DRAWDOWN=
BTC_MAX_TRADES_PER_DAY=
BTC_COOLDOWN_MINUTES=
BTC_TIMECUT_DAYS=
BTC_FEE_BUY=
BTC_FEE_SELL=
BTC_DYNAMIC_WEIGHTS=
BTC_VOLATILITY_FILTER=
BTC_FUNDING_FILTER=
BTC_OI_FILTER=
BTC_KIMCHI_PREMIUM_MAX=
